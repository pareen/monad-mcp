# Monad RPC endpoints (override the bundled defaults)
MONAD_MAINNET_RPC=https://rpc.monad.xyz
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Which Monad network the server defaults to ("mainnet" | "testnet").
# Read tools accept a `network` arg; this is the fallback when omitted.
MONAD_DEFAULT_NETWORK=testnet

# Privy app credentials — create at https://dashboard.privy.io
# Configure embedded wallets and enable Monad chains (143 and 10143).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Public base URL of THIS server. Used to build approval URLs that we hand back
# to the agent. In local dev this is something like http://localhost:8787.
PUBLIC_BASE_URL=http://localhost:8787

# HTTP port for the Streamable HTTP transport + approval pages.
PORT=8787

# Optional: comma-separated list of allowed OAuth redirect URIs for MCP clients.
ALLOWED_REDIRECT_URIS=

# Optional log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Optional: webhook fired on every stored-request lifecycle event
# (created, approved, rejected, expired). Plug into Slack/Telegram/Discord
# via your own relay.
NOTIFICATION_WEBHOOK_URL=

# Optional: Monad Name Service resolver address (when MNS publishes one)
MONAD_NAME_SERVICE_RESOLVER=

# Persistence backend: "memory" (single-process dev) or "postgres" (production).
# When "postgres", DATABASE_URL must be set.
STORE_BACKEND=memory
DATABASE_URL=
