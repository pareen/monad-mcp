# Monad RPC endpoints (override the bundled defaults)
MONAD_MAINNET_RPC=https://rpc.monad.xyz
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Which Monad network the server defaults to ("mainnet" | "testnet").
# Read tools accept a `network` arg; this is the fallback when omitted.
MONAD_DEFAULT_NETWORK=testnet

# Privy app credentials — create at https://dashboard.privy.io
# Configure embedded wallets and enable Monad chains (143 and 10143).
# With these set, /mcp runs in "split" mode: read tools stay public (anonymous),
# write tools require a Privy bearer token. With them unset, /mcp is fully open.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional: require a bearer token for EVERY /mcp call, reads included (the
# stricter pre-split behavior). Only applies when Privy is configured. Accepts
# 1/true/yes/on. Default (unset/false) keeps read tools public.
MONAD_MCP_REQUIRE_AUTH=

# Public base URL of THIS server. Used to build approval URLs that we hand back
# to the agent. In local dev this is something like http://localhost:8787.
PUBLIC_BASE_URL=http://localhost:8787

# HTTP port for the Streamable HTTP transport + approval pages.
PORT=8787

# Optional: comma-separated list of allowed OAuth redirect URIs for MCP clients.
ALLOWED_REDIRECT_URIS=

# Secret for signing OAuth client_ids + per-request approval tokens (≥32 chars).
# Used by the hosted OAuth login bridge (/oauth/register, /authorize, /token).
# If unset, the server generates an ephemeral one at boot and registered OAuth
# clients are invalidated on restart — set a stable value for any real deploy:
#   openssl rand -hex 32
# NOTE: the Privy app's "Allowed origins" (dashboard → Settings) must include
# PUBLIC_BASE_URL or the browser login modal on /authorize won't initialise.
MONAD_MCP_APPROVAL_SECRET=

# Optional log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Optional: webhook fired on every stored-request lifecycle event
# (created, approved, rejected, expired). Plug into Slack/Telegram/Discord
# via your own relay.
NOTIFICATION_WEBHOOK_URL=

# Nad Name Service (.nad) resolution works out of the box — no config needed.
# This optional var is only a fallback ENS-style addr(node) resolver for OTHER
# (non-.nad) name suffixes. Leave blank unless you run such a resolver.
MONAD_NAME_SERVICE_RESOLVER=

# Persistence backend: "memory" (single-process dev) or "postgres" (production).
# When "postgres", DATABASE_URL must be set.
STORE_BACKEND=memory
DATABASE_URL=
